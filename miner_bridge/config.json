{
  "name": "Miner Bridge",
  "version": "0.2.2",
  "slug": "miner_bridge",
  "description": "ASIC miner monitoring & control: discovery, health, coolant flow, TimescaleDB history, MQTT for Home Assistant",
  "url": "https://github.com/VersloValdymas/Minning",
  "arch": [
    "amd64",
    "aarch64"
  ],
  "startup": "application",
  "boot": "auto",
  "init": true,
  "host_network": true,
  "ingress": true,
  "ingress_port": 3000,
  "panel_icon": "mdi:pickaxe",
  "panel_title": "Miners",
  "panel_admin": true,
  "services": [
    "mqtt:want"
  ],
  "backup": "cold",
  "options": {
    "log_level": "info",
    "mqtt_host": "",
    "mqtt_port": 1883,
    "mqtt_username": "",
    "mqtt_password": "",
    "vnish_api_key": "",
    "retention_days": 90,
    "db_mode": "embedded"
  },
  "schema": {
    "log_level": "list(trace|debug|info|warn|error)",
    "mqtt_host": "str?",
    "mqtt_port": "port",
    "mqtt_username": "str?",
    "mqtt_password": "password?",
    "vnish_api_key": "password?",
    "retention_days": "int(0,3650)",
    "db_mode": "list(embedded|external)",
    "db_host": "str?",
    "db_port": "port?",
    "db_name": "str?",
    "db_user": "str?",
    "db_password": "password?",
    "db_ssl": "bool?",
    "mqtt_discovery_prefix": "str?",
    "mqtt_base_topic": "str?",
    "poll_interval_s": "int(5,3600)?",
    "poll_concurrency": "int(1,200)?",
    "poll_timeout_ms": "int(500,30000)?",
    "offline_after_failures": "int(1,100)?",
    "scan_concurrency": "int(1,512)?",
    "scan_timeout_ms": "int(200,10000)?",
    "temp_critical_c": "int(40,130)?",
    "temp_warn_c": "int(30,130)?",
    "water_in_warn_c": "int(5,80)?",
    "water_out_warn_c": "int(5,90)?",
    "water_out_crit_c": "int(5,95)?",
    "water_delta_warn_c": "int(1,50)?",
    "hashrate_warn_pct": "int(1,100)?",
    "hashrate_crit_pct": "int(1,100)?",
    "hashrate_grace_s": "int(0,7200)?",
    "reject_warn_pct": "int(0,100)?",
    "reject_crit_pct": "int(0,100)?",
    "stuck_starting_s": "int(60,7200)?",
    "relay_cycle_delay_s": "int(1,600)?",
    "ingress_only": "bool?",
    "flow_required_lpm": "float(0,100)?",
    "flow_required_default_lpm": "float(0,100)?",
    "coolant_type": "list(water|ethylene_glycol|propylene_glycol)?",
    "coolant_glycol_pct": "int(0,60)?",
    "coolant_cp": "int(0,5000)?",
    "coolant_density": "float(0,2)?",
    "fw_log_interval_s": "int(15,3600)?",
    "fw_event_window_h": "int(1,168)?",
    "standby_power_w": "int(0,1000)?",
    "vnish_password": "password?"
  }
}
