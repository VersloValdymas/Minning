# Local development config. Copy to .env (loaded automatically on startup).
LOG_LEVEL=debug
HTTP_PORT=3000
INGRESS_ONLY=false

# Either a full URL (takes priority) ...
DATABASE_URL=postgres://miner:miner@localhost:5442/miners
# ... or separate variables
# DB_HOST=localhost
# DB_PORT=5442
# DB_NAME=miners
# DB_USER=miner
# DB_PASSWORD=miner
# DB_SSL=false
RETENTION_DAYS=90

# Leave MQTT_HOST and MQTT_URL empty to run without MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
# MQTT_URL=mqtt://user:pass@localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_BASE_TOPIC=minerbridge

POLL_INTERVAL_S=15
POLL_CONCURRENCY=25
POLL_TIMEOUT_MS=4000
OFFLINE_AFTER_FAILURES=3
SCAN_CONCURRENCY=64
SCAN_TIMEOUT_MS=1500
# Dashboard login (super-admin password). Session lasts SESSION_IDLE_DAYS without activity.
# Licensing (signed license key). For local dev you can set LICENSE_ENABLED=false.
LICENSE_ENABLED=true
LICENSE_GRACE_DAYS=7

# Earnings (F2Pool API + BTC/EUR price). Token: F2Pool paskyra -> API.
F2POOL_ACCOUNT=
F2POOL_TOKEN=
ELECTRICITY_EUR_KWH=0.12
# BTC_PRICE_MANUAL=0   # 0 = auto (CoinGecko)

AUTH_ENABLED=true
SESSION_IDLE_DAYS=30
# Forgotten password: set to true, restart, then set back to false
ADMIN_PASSWORD_RESET=false

# Health thresholds
TEMP_WARN_C=75
TEMP_CRITICAL_C=85
WATER_IN_WARN_C=35
WATER_OUT_WARN_C=45
WATER_OUT_CRIT_C=50
WATER_DELTA_WARN_C=15
HASHRATE_WARN_PCT=90
HASHRATE_CRIT_PCT=75
HASHRATE_GRACE_S=600
REJECT_WARN_PCT=1
REJECT_CRIT_PCT=3
STUCK_STARTING_S=900
TUNING_WARN_H=12
TUNING_INTERRUPTIONS_WARN=3
RELAY_CYCLE_DELAY_S=10

# Coolant flow estimate (hydro). Required flow: 0 = per model spec (S21+/XP/XP+ Hyd. = 8 L/min)
FLOW_REQUIRED_LPM=0
FLOW_REQUIRED_DEFAULT_LPM=8
# Coolant: water | ethylene_glycol | propylene_glycol, concentration in % (volume)
COOLANT_TYPE=ethylene_glycol
COOLANT_GLYCOL_PCT=30
# Optional exact datasheet values (0 = derive from type/concentration)
COOLANT_CP=0
COOLANT_DENSITY=0
FLOW_MIN_POWER_W=1000
FLOW_MIN_DELTA_C=2

# Firmware log reading (overheat / chain-break protection trips happen between polls)
FW_LOG_INTERVAL_S=60
FW_EVENT_WINDOW_H=6

# Wall draw (W) of a powered miner that is not hashing. Firmware reports 0 W then.
# 0 = unknown -> shown as "not measured". Measure once (e.g. Shelly PM / clamp meter) and set it.
STANDBY_POWER_W=0

# Vnish firmware commands (restart/reboot). API key preferred; password as fallback.
VNISH_API_KEY=
VNISH_PASSWORD=
