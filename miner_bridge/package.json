{
  "name": "miner-bridge",
  "version": "0.6.0",
  "description": "ASIC miner discovery, telemetry (TimescaleDB) and MQTT bridge for Home Assistant",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "mock": "tsx tools/mock-miners.ts",
    "deps:up": "docker compose -f ../docker-compose.yml up -d --wait",
    "deps:down": "docker compose -f ../docker-compose.yml down",
    "license:genkeys": "tsx tools/license-keygen.ts",
    "license:issue": "tsx tools/issue-license.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "mqtt": "^5.16.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
